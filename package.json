{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "cypress:open": "cypress open",
        "cypress:run": "cypress run",
        "cypress:serve": "node cypress/scripts/require-env.mjs && php artisan serve --env=cypress --port=8000",
        "cypress:db": "node cypress/scripts/require-env.mjs && php artisan migrate:fresh --seed --env=cypress --force && php artisan db:seed --class=CypressSeeder --env=cypress --force",
        "test:e2e": "npm run cypress:db && start-server-and-test cypress:serve http://127.0.0.1:8000/up cypress:run",
        "test:e2e:open": "start-server-and-test cypress:serve http://127.0.0.1:8000/up cypress:open"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "cypress": "^16.2.0",
        "laravel-vite-plugin": "^3.1",
        "start-server-and-test": "^3.0.13",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "dhtmlx-gantt": "^10.0.3"
    }
}
